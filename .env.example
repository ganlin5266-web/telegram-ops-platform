# Copy to .env locally. Never commit .env or actual secrets.
DATABASE_URL=postgresql://telegram_app:CHANGE_ME@127.0.0.1:5432/telegram_ops
HOST=127.0.0.1
PORT=3000
# For each bot, store the VARIABLE NAME in its *_secret_ref fields.
# Actual values go only in deployment secrets / local .env. Do not enter production tokens in phase one.
BOT_EXAMPLE_TOKEN=
BOT_EXAMPLE_WEBHOOK_SECRET=
# Optional integration test database; must be disposable, not production.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/telegram_test
# Browser authentication. Include exact UI origins, separated by commas.
# Production requires HTTPS origins and always uses Secure cookies.
NODE_ENV=development
ADMIN_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAME_SITE=Lax
ADMIN_SESSION_SECONDS=28800
# Optional server-only cursor signing secret (>=32 random bytes). Set the same
# value on all replicas; leave blank locally for an ephemeral per-process key.
QUERY_CURSOR_SECRET=
