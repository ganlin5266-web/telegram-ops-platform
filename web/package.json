{
  "name": "telegram-ops-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests e2e *.ts *.json index.html",
    "start:staging": "node server/staging-server.mjs",
    "test:proxy": "node --test server/tests/*.test.mjs",
    "prebuild": "node server/bundle-scan.mjs --prebuild",
    "postbuild": "npm run scan:bundle",
    "scan:bundle": "node server/bundle-scan.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
